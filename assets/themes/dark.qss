QWidget { background: #26292e; color: #eceef2; font-family: "Noto Sans", sans-serif; font-size: 14px; }
QFrame#card { background: #383d45; border: 1px solid #565d68; border-radius: 18px; }
QFrame#card QLabel { background: transparent; }
QLabel#eyebrow { color: #a9b0ba; font-size: 11px; font-weight: 700; }
QLabel#hero { color: #f5f6f8; font-size: 54px; font-weight: 800; }
QLabel#subtitle { color: #d0d5dd; font-size: 19px; font-weight: 600; }
QLabel#description { color: #adb5c0; font-size: 13px; }
QLabel#credit { color: #939ba5; font-size: 11px; }
QLabel#heading { font-size: 26px; font-weight: 700; }
QPushButton { border: 1px solid #606874; border-radius: 9px; background: #414750; padding: 10px 18px; font-weight: 600; }
QPushButton:hover { background: #515a65; }
QPushButton#primary { background: #687f9b; color: white; border-color: #879bb1; }
QPushButton#primary:hover { background: #7992ae; }
QLineEdit { background: #363c44; border: 1px solid #606874; border-radius: 6px; padding: 9px; }
QAbstractItemView, QPlainTextEdit, QTextEdit { background: #363c44; alternate-background-color: #3d434c; border: 1px solid #606874; border-radius: 6px; selection-background-color: #687f9b; selection-color: white; }
QAbstractItemView::item { background: transparent; }
QAbstractItemView::item:selected { background: #687f9b; color: white; }
QHeaderView::section { background: #414750; color: #eceef2; border: 1px solid #565d68; padding: 6px; }
QTabWidget::pane { background: #363c44; border: 1px solid #606874; }
QTabBar::tab { background: #32363d; border: 1px solid #565d68; padding: 8px 14px; }
QTabBar::tab:selected { background: #414750; }
