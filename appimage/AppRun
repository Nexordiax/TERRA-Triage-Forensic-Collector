#!/bin/sh
set -eu
appdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export QT_PLUGIN_PATH="$appdir/usr/python/lib/python3.13/site-packages/PySide6/Qt/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$QT_PLUGIN_PATH/platforms"
export PYTHONDONTWRITEBYTECODE=1
if [ "${1-}" = "--terra-python" ]; then
    shift
    exec "$appdir/usr/python/bin/python" "$@"
fi
exec "$appdir/usr/python/bin/python" -B "$appdir/usr/share/terra/main.py" "$@"
